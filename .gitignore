# =========================================================================
# Ansible Core & Runtime Files
# =========================================================================
# Avoid committing automatically generated retry files when playbooks fail
*.retry

# Ansible execution log files (if configured to write locally)
*.log
ansible-errors.log

# Local/temporary collections and roles downloaded via ansible-galaxy
# (These should be managed via a collections/requirements.yml file instead)
collections/
roles/
.ansible/

# =========================================================================
# Secrets & Security Safeguards (CRITICAL)
# =========================================================================
# Explicitly block raw private keys accidentally placed in the workspace
*.pem
*.key
*.id_rsa
id_rsa*

# Block explicit cleartext variable files
# Tip: Use .vault.yml for files encrypted with Ansible Vault so they CAN be committed safely
*secret*
*password*
credentials.yml
vault_password_file

# =========================================================================
# Python Environment & Package Artifacts
# =========================================================================
# Ansible runs on Python; ignore compiled bytecode and local virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
ENV/
.env

# =========================================================================
# Editor & OS Specific Files
# =========================================================================
# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code and JetBrains/PyCharm project directories
.vscode/
.idea/
*.swp
*.swo
.DS_Store

